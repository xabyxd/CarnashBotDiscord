const { SlashCommandBuilder } = require('@discordjs/builders');
const { MessageEmbed } = require('discord.js');
const axios = require('axios');

module.exports = {
    data: new SlashCommandBuilder()
        .setName('serverstatus')
        .setDescription('Check the status of different APIs.'),
    async execute(interaction) {
        await interaction.deferReply();

        const apis = [
            {
                name: 'API 1',
                url: 'http://',
            },
            {
                name: 'API 2',
                url: 'http://',
            },
            {
                name: 'API 3',
                url: 'http://',
            }
        ];

        const handleError = (error) => {
            console.error('Error checking API status:', error);
            return 'Error';
        };

        const statuses = await Promise.all(apis.map(async api => {
            try {
                const response = await axios.get(api.url);
                return { name: api.name, status: response.status === 200 ? 'Online' : 'Offline' };
            } catch (error) {
                return { name: api.name, status: handleError(error) };
            }
        }));

        const embed = new MessageEmbed()
            .setColor('#0099ff')
            .setTitle('Server Status')
            .setDescription('Current status of the APIs')
            .setTimestamp();

        statuses.forEach(apiStatus => {
            embed.addField(apiStatus.name, apiStatus.status, true);
        });

        await interaction.editReply({ embeds: [embed] });
    }
};
