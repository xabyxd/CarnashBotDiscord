{
	"name": "carnashbot",
	"version": "2.0.2",
	"description": "Discord Bot from CarnashGG/6X6 Dev Team",
	"license": "Apache-2.0",
	"author": {
		"name": "xabyxd",
		"email": "xabybrad@gmail.com",
		"url": "https://xabyserver.ddns.net/portfolio"
	},
	"private": true,
	"type": "module",
	"main": "dist/bot.js",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
		"build": "npm run clean && tsc",
		"start": "node --enable-source-maps dist/bot.js",
		"dev": "tsx watch src/bot.ts",
		"typecheck": "tsc --noEmit",
        "deploy": "node dist/deploy.js",
        "deploy:dev": "tsx src/deploy.ts"
	},
	"dependencies": {
		"axios": "^1.21.0",
		"cheerio": "^1.2.0",
		"discord.js": "^14.28.1",
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"kleur": "^4.1.5"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^22.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
